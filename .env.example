# Copy this file to .env.local and fill in the values from your Supabase project
# (project page > Connect, or Project Settings > Data API / API Keys).
# Use the public publishable key (sb_publishable_...) or the legacy anon key (eyJ...).
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# --- Customer support (optional; see docs/SUPPORT_SETUP.md) ---
# ElevenLabs agent id (public). Without it the widget shows a plain ticket form.
VITE_ELEVENLABS_AGENT_ID=agent_your_agent_id
# n8n production webhook from the "DealDesk AI - Support Desk" workflow.
VITE_N8N_SUPPORT_WEBHOOK_URL=https://YOUR_INSTANCE.app.n8n.cloud/webhook/dealdesk-support
